# Copy this file to .env for local development (never commit the real .env).
# In production, set this as a Vercel project env var instead (see README.md).

# Public site key from dash.cloudflare.com -> Turnstile -> your widget.
# This one is meant to be public (it's sent to the browser), unlike the
# secret key below which must NEVER be prefixed with VITE_.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
